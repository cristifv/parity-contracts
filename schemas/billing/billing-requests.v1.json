{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parity.example/schemas/billing-requests/v1.json",
  "title": "parity-billing commands, schema_version 1",
  "description": "On three topics; the topic decides what may run (CONVENTIONS.md 'Billing API'). billing.web.requests (written by parity-frontend only, by Kafka ACL) runs the commands marked x-web, and its only reply_to is replies.parity-frontend. billing.requests (admin-console) runs the unmarked reads; billing.admin.requests (admin-console) the commands marked x-admin. ping runs on all three. A command on the wrong topic is answered forbidden. Signup commands come before any tenant exists: keyed by signup_id, no tenant_id header. x-reserved names commands of later steps.",
  "type": "object",
  "required": [
    "schema_version",
    "cmd",
    "id",
    "reply_to"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "cmd": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,200}$"
    },
    "reply_to": {
      "type": "string",
      "pattern": "^replies\\.[a-z0-9][a-z0-9.-]{0,200}$"
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/cmd_ping"
    },
    {
      "$ref": "#/$defs/cmd_get_entitlements"
    },
    {
      "$ref": "#/$defs/cmd_get_catalog"
    },
    {
      "$ref": "#/$defs/cmd_check_slug"
    },
    {
      "$ref": "#/$defs/cmd_start_signup"
    },
    {
      "$ref": "#/$defs/cmd_get_signup_status"
    },
    {
      "$ref": "#/$defs/cmd_change_slug"
    },
    {
      "$ref": "#/$defs/cmd_create_signup_checkout"
    },
    {
      "$ref": "#/$defs/cmd_confirm_checkout"
    }
  ],
  "unevaluatedProperties": false,
  "x-reserved": [
    "get_workspace",
    "resend_admin_invite",
    "get_account",
    "list_ledger_entries",
    "create_upgrade_checkout",
    "preview_seat_change",
    "change_seats",
    "create_portal_session",
    "start_identity_verification",
    "cancel_subscription",
    "undo_cancel",
    "create_topup_checkout",
    "set_auto_recharge",
    "list_provisionings",
    "set_contract_entitlements",
    "set_fraud_tier",
    "restrict_tenant",
    "unrestrict_tenant",
    "approve_action",
    "approve_review",
    "reject_review",
    "refund_signup",
    "retry_provisioning",
    "adjust_credit"
  ],
  "$defs": {
    "cmd_ping": {
      "type": "object",
      "required": [
        "cmd"
      ],
      "properties": {
        "cmd": {
          "const": "ping"
        }
      }
    },
    "cmd_get_entitlements": {
      "type": "object",
      "required": [
        "cmd",
        "tenant_id"
      ],
      "properties": {
        "cmd": {
          "const": "get_entitlements"
        },
        "tenant_id": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
        }
      }
    },
    "cmd_get_catalog": {
      "type": "object",
      "required": [
        "cmd"
      ],
      "properties": {
        "cmd": {
          "const": "get_catalog"
        }
      },
      "x-web": true
    },
    "cmd_check_slug": {
      "type": "object",
      "required": [
        "cmd",
        "slug"
      ],
      "properties": {
        "cmd": {
          "const": "check_slug"
        },
        "slug": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
          "description": "A requested tenant id: the tenant_id format, 3 to 40 characters"
        }
      },
      "x-web": true
    },
    "cmd_start_signup": {
      "type": "object",
      "required": [
        "cmd",
        "signup_id",
        "email",
        "name",
        "company",
        "country",
        "slug",
        "region",
        "plan",
        "consents",
        "consented_at_ms"
      ],
      "properties": {
        "cmd": {
          "const": "start_signup"
        },
        "signup_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 254,
          "pattern": "^[^@\\s\u0000-\u001f]{1,64}@[^@\\s\u0000-\u001f]{1,253}$",
          "x-pii": "email"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^\u0000-\u001f]+$"
        },
        "company": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^\u0000-\u001f]+$"
        },
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$",
          "description": "ISO 3166-1 alpha-2"
        },
        "vat_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 4,
              "maxLength": 20,
              "pattern": "^[A-Za-z0-9 .-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "slug": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
          "description": "A requested tenant id: the tenant_id format, 3 to 40 characters"
        },
        "slug_review": {
          "type": "boolean",
          "description": "The slug is on the brand list: a person reviews it"
        },
        "region": {
          "type": "string",
          "pattern": "^[a-z]{2,8}[0-9]{1,3}$",
          "description": "A region, e.g. eu1"
        },
        "plan": {
          "type": "object",
          "required": [
            "kind",
            "plan_id"
          ],
          "properties": {
            "kind": {
              "enum": [
                "trial",
                "paid"
              ]
            },
            "plan_id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
            },
            "seats": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 50,
              "description": "Null or absent: the trial's cap, or the plan's minimum"
            }
          },
          "additionalProperties": false
        },
        "locale": {
          "type": "string",
          "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"
        },
        "consents": {
          "type": "object",
          "required": [
            "terms",
            "privacy",
            "dpa"
          ],
          "properties": {
            "terms": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,40}$"
            },
            "privacy": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,40}$"
            },
            "dpa": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,40}$"
            },
            "aup": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,40}$"
            }
          },
          "additionalProperties": false,
          "description": "The versions of the legal texts accepted"
        },
        "consented_at_ms": {
          "type": "integer",
          "minimum": 0
        },
        "marketing_opt_in": {
          "type": "boolean"
        },
        "verified_at_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "x-web": true
    },
    "cmd_get_signup_status": {
      "type": "object",
      "required": [
        "cmd",
        "signup_id"
      ],
      "properties": {
        "cmd": {
          "const": "get_signup_status"
        },
        "signup_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "x-web": true
    },
    "cmd_change_slug": {
      "type": "object",
      "required": [
        "cmd",
        "signup_id",
        "slug"
      ],
      "properties": {
        "cmd": {
          "const": "change_slug"
        },
        "signup_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "slug": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
          "description": "A requested tenant id: the tenant_id format, 3 to 40 characters"
        }
      },
      "x-web": true
    },
    "cmd_create_signup_checkout": {
      "type": "object",
      "required": [
        "cmd",
        "signup_id"
      ],
      "properties": {
        "cmd": {
          "const": "create_signup_checkout"
        },
        "signup_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "kind": {
          "enum": [
            "trial",
            "paid"
          ]
        },
        "plan_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "seats": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      },
      "x-web": true
    },
    "cmd_confirm_checkout": {
      "type": "object",
      "required": [
        "cmd",
        "signup_id",
        "checkout_session_id"
      ],
      "properties": {
        "cmd": {
          "const": "confirm_checkout"
        },
        "signup_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "checkout_session_id": {
          "type": "string",
          "pattern": "^cs_[A-Za-z0-9_]{1,250}$",
          "description": "A Stripe Checkout Session id"
        }
      },
      "x-web": true
    }
  }
}
