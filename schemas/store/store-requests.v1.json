    },
    "cmd_add_sip_domain": {
      "type": "object",
      "required": [
        "cmd",
        "tenant_id",
        "domain"
      ],
      "properties": {
        "cmd": {
          "const": "add_sip_domain"
        },
        "tenant_id": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "domain": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$"
        }
      },
      "x-admin": true
    },
    "cmd_remove_sip_domain": {
      "type": "object",
      "required": [
        "cmd",
        "tenant_id",
        "domain"
      ],
      "properties": {
        "cmd": {
