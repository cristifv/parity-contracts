          "type": "integer",
          "minimum": 0,
          "description": "Optimistic locking: the current version must equal this (0: the tenant, or the placement, must not exist). Left out: unconditional"
        }
      },
      "x-admin": true
    },
    "cmd_add_number": {
      "type": "object",
      "required": [
        "cmd",
        "tenant_id",
