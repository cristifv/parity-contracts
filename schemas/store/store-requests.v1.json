        },
        "tenant_id": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "number": {
          "type": "string",
          "pattern": "^\\+[1-9][0-9]{6,14}$",
          "x-pii": "phone"
        }
      },
      "x-admin": true
    },
    "cmd_remove_number": {
      "type": "object",
      "required": [
        "cmd",
        "tenant_id",
        "number"
      ],
      "properties": {
        "cmd": {
          "const": "remove_number"
        },
        "tenant_id": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "number": {
          "type": "string",
          "pattern": "^\\+[1-9][0-9]{6,14}$",
          "x-pii": "phone"
        }
      },
