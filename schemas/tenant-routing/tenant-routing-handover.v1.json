{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parity.example/schemas/tenant-routing/handover/v1.json",
  "title": "Handover reports to parity-rs (0.16.0)",
  "description": "tenant.routing.handover.<zone>, written by a zone's per-tenant services (interaction-engine, routing-engine, gateway, …) when they have handed over (released) or taken over (adopted) a tenant's live work for an assignment epoch (ARCH §7.8). parity-rs waits for `released` from each service its topology lists before a unit move is done; a report for an older epoch is ignored. Keyed by tenant id; header tenant_id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "tenant_id",
    "unit",
    "epoch",
    "service",
    "instance",
    "state",
    "at_ms"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "UUIDv7, lowercase."
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
      "description": "A DNS label (CONVENTIONS \"Identifiers and values\")."
    },
    "unit": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$",
      "description": "A region, zone (= cell), deployment unit (= bin) or media track name (eu1, eu1a, bin-a, blue)."
    },
    "epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "service": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,62}$"
    },
    "instance": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "state": {
      "enum": [
        "released",
        "adopted"
      ]
    },
    "at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "saga_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "UUIDv7, lowercase."
    }
  }
}
