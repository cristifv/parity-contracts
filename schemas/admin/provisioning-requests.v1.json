{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parity.example/schemas/provisioning-requests/v1.json",
  "title": "admin-console provisioning commands, schema_version 1",
  "description": "On admin.provisioning.requests, written by parity-billing only (Kafka ACL); admin-console owns the tenant-id namespace and creates tenants (CONVENTIONS.md 'Provisioning'). Keyed by the tenant id the command names, else signup_id. The only reply_to is replies.parity-billing.",
  "type": "object",
  "required": [
    "schema_version",
    "cmd",
    "id",
    "reply_to"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "cmd": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,200}$"
    },
    "reply_to": {
      "type": "string",
      "pattern": "^replies\\.[a-z0-9][a-z0-9.-]{0,200}$"
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/cmd_check_tenant_id"
    },
    {
      "$ref": "#/$defs/cmd_reserve_tenant_id"
    },
    {
      "$ref": "#/$defs/cmd_release_tenant_id"
    },
    {
      "$ref": "#/$defs/cmd_provision_tenant"
    },
    {
      "$ref": "#/$defs/cmd_get_provisioning"
    },
    {
      "$ref": "#/$defs/cmd_get_seat_usage"
    },
    {
      "$ref": "#/$defs/cmd_resend_admin_invite"
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "cmd_check_tenant_id": {
      "type": "object",
      "required": [
        "cmd",
        "tenant_id"
      ],
      "properties": {
        "cmd": {
          "const": "check_tenant_id"
        },
        "tenant_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
          "description": "A requested tenant id: the tenant_id format, 3 to 40 characters"
        }
      }
    },
    "cmd_reserve_tenant_id": {
      "type": "object",
      "required": [
        "cmd",
        "tenant_id",
        "holder",
        "ttl_s"
      ],
      "properties": {
        "cmd": {
          "const": "reserve_tenant_id"
        },
        "tenant_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
          "description": "A requested tenant id: the tenant_id format, 3 to 40 characters"
        },
        "holder": {
          "type": "string",
          "pattern": "^(?:signup:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|onboarding:[A-Za-z0-9._:-]{1,120})$",
          "description": "Who holds a reservation: a self-serve signup, or an operator's onboarding"
        },
        "ttl_s": {
          "type": "integer",
          "minimum": 60,
          "maximum": 604800
        }
      }
    },
    "cmd_release_tenant_id": {
      "type": "object",
      "required": [
        "cmd",
        "tenant_id",
        "holder"
      ],
      "properties": {
        "cmd": {
          "const": "release_tenant_id"
        },
        "tenant_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
          "description": "A requested tenant id: the tenant_id format, 3 to 40 characters"
        },
        "holder": {
          "type": "string",
          "pattern": "^(?:signup:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|onboarding:[A-Za-z0-9._:-]{1,120})$",
          "description": "Who holds a reservation: a self-serve signup, or an operator's onboarding"
        }
      }
    },
    "cmd_provision_tenant": {
      "type": "object",
      "required": [
        "cmd",
        "signup_id",
        "tenant_id",
        "name",
        "tier",
        "region",
        "admin",
        "locale",
        "country"
      ],
      "properties": {
        "cmd": {
          "const": "provision_tenant"
        },
        "signup_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "tenant_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
          "description": "A requested tenant id: the tenant_id format, 3 to 40 characters"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^\u0000-\u001f]+$"
        },
        "tier": {
          "enum": [
            "small"
          ]
        },
        "region": {
          "type": "string",
          "pattern": "^[a-z]{2,8}[0-9]{1,3}$",
          "description": "A region, e.g. eu1"
        },
        "admin": {
          "type": "object",
          "required": [
            "email",
            "name"
          ],
          "properties": {
            "email": {
              "type": "string",
              "minLength": 3,
              "maxLength": 254,
              "pattern": "^[^@\\s\u0000-\u001f]{1,64}@[^@\\s\u0000-\u001f]{1,253}$",
              "x-pii": "email"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[^\u0000-\u001f]+$"
            }
          },
          "additionalProperties": false
        },
        "locale": {
          "type": "string",
          "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"
        },
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$",
          "description": "ISO 3166-1 alpha-2"
        }
      }
    },
    "cmd_get_provisioning": {
      "type": "object",
      "required": [
        "cmd",
        "signup_id"
      ],
      "properties": {
        "cmd": {
          "const": "get_provisioning"
        },
        "signup_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      }
    },
    "cmd_get_seat_usage": {
      "type": "object",
      "required": [
        "cmd",
        "tenant_id",
        "day"
      ],
      "properties": {
        "cmd": {
          "const": "get_seat_usage"
        },
        "tenant_id": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "day": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "A UTC day, YYYY-MM-DD"
        }
      }
    },
    "cmd_resend_admin_invite": {
      "type": "object",
      "required": [
        "cmd",
        "signup_id"
      ],
      "properties": {
        "cmd": {
          "const": "resend_admin_invite"
        },
        "signup_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      }
    }
  }
}
