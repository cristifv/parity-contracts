          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,64}$"
        }
      }
    },
    "pong": {
      "description": "Answers ping",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "type"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "pong"
        }
      }
    },
    "hold": {
