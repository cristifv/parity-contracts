{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parity.example/schemas/agent-ws/to-gateway/v1.json",
  "title": "agent-ws.v1 frames to gateway",
  "description": "Desktop -> gateway. No frame names a tenant or an agent: both come from the token. id is a UUID the desktop makes per command; the gateway derives command_id from it.",
  "oneOf": [
    {
      "$ref": "#/$defs/auth"
    },
    {
      "$ref": "#/$defs/set_state"
    },
    {
      "$ref": "#/$defs/accept"
    },
    {
      "$ref": "#/$defs/reject"
    },
    {
      "$ref": "#/$defs/transfer"
    },
    {
      "$ref": "#/$defs/consult"
    },
    {
      "$ref": "#/$defs/remove_party"
    },
    {
      "$ref": "#/$defs/wrap_up_done"
    },
    {
      "$ref": "#/$defs/pong"
    },
    {
      "$ref": "#/$defs/hold"
    },
    {
      "$ref": "#/$defs/resume"
    },
    {
      "$ref": "#/$defs/mute"
    },
    {
      "$ref": "#/$defs/unmute"
    },
    {
      "$ref": "#/$defs/hangup"
    },
    {
      "$ref": "#/$defs/merge"
    },
    {
      "$ref": "#/$defs/complete_transfer"
    },
    {
      "$ref": "#/$defs/cancel_consult"
    }
  ],
  "$defs": {
    "auth": {
      "description": "First frame within 5 s, and again before exp to refresh",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "type",
        "token"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "auth"
        },
        "token": {
          "type": "string",
          "minLength": 16,
          "maxLength": 8192,
          "x-secret": true
        },
        "client_version": {
          "type": "string",
          "maxLength": 64
        }
      }
    },
    "set_state": {
      "description": "RE SetState",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "type",
        "id",
        "state"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "set_state"
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "state": {
          "enum": [
            "ready",
            "not_ready",
            "logged_out"
          ]
        },
        "reason_code": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,64}$"
        }
      }
    },
    "accept": {
      "description": "RE AnswerOffer(ACCEPT)",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "type",
        "id",
        "offer_id"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "accept"
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "offer_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      }
    },
    "reject": {
      "description": "RE AnswerOffer(REJECT)",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "type",
        "id",
        "offer_id"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "reject"
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "offer_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "reason": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,64}$"
        }
      }
    },
    "transfer": {
      "description": "IE BlindTransfer",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "type",
        "id",
        "interaction_id",
        "target"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "transfer"
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "interaction_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "maxProperties": 1,
          "properties": {
            "queue_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{1,64}$"
            },
            "agent_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "number": {
              "type": "string",
              "pattern": "^\\+[1-9][0-9]{6,14}$",
              "x-pii": "phone"
            }
          }
        }
      }
    },
    "consult": {
      "description": "IE Consult",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "type",
        "id",
        "interaction_id",
