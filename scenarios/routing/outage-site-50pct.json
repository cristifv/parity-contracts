{
  "schema_version": 1,
  "name": "outage-site-50pct",
  "description": "An outage at the peak: site-b (half the agents) drops off at once and comes back 10 minutes later; then IE loses its Watch stream for 10 s, the gateway disconnects for 10 s, and finally the routing engine restarts (phase-1 rule: the stack restarts with it)",
  "seed": 1,
  "duration_s": 3600,
  "bin": "bin-a",
  "tenants": [
    {
      "id": "acme",
      "queues": [
        {
          "id": "sales",
          "max_wait_s": 240,
          "max_wait_action": {
            "action": "disconnect"
          },
          "arrivals": {
            "kind": "profile",
            "bucket_s": 600,
            "shape": [
              0.5,
              0.8,
              1.0,
              1.0,
              0.8,
              0.5
            ],
            "scale_per_hour": 150
          },
          "handle_time": {
            "kind": "lognormal",
            "mean_s": 180,
            "cv": 0.8
          },
          "patience": {
            "kind": "exponential",
            "mean_s": 90
          }
        },
        {
          "id": "support",
          "max_wait_s": 300,
          "max_wait_action": {
            "action": "disconnect"
          },
          "arrivals": {
            "kind": "piecewise",
            "bucket_s": 3600,
            "per_hour": [
              60
            ]
          },
          "handle_time": {
            "kind": "lognormal",
            "mean_s": 180,
            "cv": 0.8
          },
          "patience": {
            "kind": "exponential",
            "mean_s": 90
          }
        }
      ],
      "agents": [
        {
          "count": 5,
          "ids": [
            "agent-a1",
            "agent-a2",
            "agent-a3"
          ],
          "id_prefix": "acme-a",
          "queues": [
            "sales",
            "support"
          ],
          "site": "site-a"
        },
        {
          "count": 5,
          "id_prefix": "acme-b",
          "queues": [
            "sales",
            "support"
          ],
          "site": "site-b"
        }
      ],
      "behaviour": {
        "answer_delay": {
          "kind": "exponential",
          "mean_s": 3
        },
        "p_reject": 0.05,
        "p_ignore": 0.03,
        "p_leg_failed": 0.02,
        "p_no_answer": 0.02,
        "wrap_up": {
          "kind": "exponential",
          "mean_s": 20
        }
      }
    }
  ],
  "expectations": {
    "invariants": "all",
    "latency_ms": {
      "p99": 50,
      "max": 250
    },
    "rss_mib_max": 512
  },
  "events": [
    {
      "at_s": 1200,
      "kind": "agent_outage",
      "tenant": "acme",
      "site": "site-b",
      "percent": 100,
      "down_s": 600,
      "note": "site-b's network drops: its desktops detach"
    },
    {
      "at_s": 2100,
      "kind": "ie_stream_lost",
      "down_s": 10
    },
    {
      "at_s": 2400,
      "kind": "gateway_disconnect",
      "down_s": 10
    },
    {
      "at_s": 3000,
      "kind": "re_restart",
      "note": "restart rule: RE, IE and the gateway restart together; waiting callers are lost"
    }
  ]
}
