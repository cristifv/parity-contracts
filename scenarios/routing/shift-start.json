{
  "schema_version": 1,
  "name": "shift-start",
  "description": "A shift start: 500 agents log in over 20 s (small scale; full scale 10k in phase 2) while calls already queue",
  "seed": 1,
  "duration_s": 900,
  "bin": "bin-a",
  "tenants": [
    {
      "id": "acme",
      "queues": [
        {
          "id": "sales",
          "max_wait_s": 300,
          "max_wait_action": {
            "action": "disconnect"
          },
          "arrivals": {
            "kind": "piecewise",
            "bucket_s": 900,
            "per_hour": [
              1200
            ]
          },
          "handle_time": {
            "kind": "lognormal",
            "mean_s": 180,
            "cv": 0.8
          },
          "patience": {
            "kind": "exponential",
            "mean_s": 90
          },
          "max_entries": 500
        }
      ],
      "agents": [
        {
          "count": 3,
          "ids": [
            "agent-a1",
            "agent-a2",
            "agent-a3"
          ],
          "queues": [
            "sales"
          ],
          "site": "site-a"
        }
      ],
      "behaviour": {
        "answer_delay": {
          "kind": "exponential",
          "mean_s": 3
        },
        "p_reject": 0.05,
        "p_ignore": 0.03,
        "p_leg_failed": 0.02,
        "p_no_answer": 0.02,
        "wrap_up": {
          "kind": "exponential",
          "mean_s": 20
        }
      }
    }
  ],
  "expectations": {
    "invariants": "all",
    "latency_ms": {
      "p99": 50,
      "max": 250
    },
    "rss_mib_max": 512
  },
  "events": [
    {
      "at_s": 60,
      "kind": "mass_login",
      "tenant": "acme",
      "count": 500,
      "over_s": 20,
      "group": {
        "count": 500,
        "id_prefix": "acme-shift",
        "queues": [
          "sales"
        ],
        "site": "site-c"
      }
    },
    {
      "at_s": 700,
      "kind": "mass_logout",
      "tenant": "acme",
      "percent": 50
    }
  ]
}
