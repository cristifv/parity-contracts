{
  "schema_version": 1,
  "name": "quiet-day",
  "description": "A not-so-busy day: two queues, six agents, low steady traffic (about 30 calls/h per queue) for an hour; everyone answered quickly",
  "seed": 1,
  "duration_s": 3600,
  "bin": "bin-a",
  "tenants": [
    {
      "id": "acme",
      "queues": [
        {
          "id": "sales",
          "max_wait_s": 300,
          "max_wait_action": {
            "action": "disconnect"
          },
          "arrivals": {
            "kind": "piecewise",
            "bucket_s": 900,
            "per_hour": [
              20,
              30,
              30,
              20
            ]
          },
          "handle_time": {
            "kind": "lognormal",
            "mean_s": 180,
            "cv": 0.8
          },
          "patience": {
            "kind": "exponential",
            "mean_s": 90
          }
        },
        {
          "id": "support",
          "max_wait_s": 300,
          "max_wait_action": {
            "action": "disconnect"
          },
          "arrivals": {
            "kind": "piecewise",
            "bucket_s": 900,
            "per_hour": [
              25,
              35,
              30,
              25
            ]
          },
          "handle_time": {
            "kind": "lognormal",
            "mean_s": 180,
            "cv": 0.8
          },
          "patience": {
            "kind": "exponential",
            "mean_s": 90
          }
        }
      ],
      "agents": [
        {
          "count": 3,
          "ids": [
            "agent-a1",
            "agent-a2",
            "agent-a3"
          ],
          "id_prefix": "acme-s",
          "queues": [
            "sales",
            "support"
          ],
          "site": "site-a"
        },
        {
          "count": 3,
          "id_prefix": "acme-t",
          "queues": [
            "support"
          ],
          "site": "site-a"
        }
      ],
      "behaviour": {
        "answer_delay": {
          "kind": "exponential",
          "mean_s": 3
        },
        "p_reject": 0.05,
        "p_ignore": 0.03,
        "p_leg_failed": 0.02,
        "p_no_answer": 0.02,
        "wrap_up": {
          "kind": "exponential",
          "mean_s": 20
        }
      }
    }
  ],
  "expectations": {
    "invariants": "all",
    "latency_ms": {
      "p99": 50,
      "max": 250
    },
    "rss_mib_max": 512,
    "kpi": [
      {
        "tenant": "acme",
        "metric": "abandon_rate",
        "max": 0.15,
        "tolerance": 0.05
      }
    ]
  }
}
