{
  "schema_version": 1,
  "name": "spike-10x-5min",
  "description": "A spike: sales gets 10 times its rate for 5 minutes mid-way (with 30 s ramps); bounded queues (max_entries 40) must refuse the excess with queue_full and every waiting caller leaves by max-wait",
  "seed": 1,
  "duration_s": 2400,
  "bin": "bin-a",
  "tenants": [
    {
      "id": "acme",
      "queues": [
        {
          "id": "sales",
          "max_wait_s": 180,
          "max_wait_action": {
            "action": "disconnect"
          },
          "arrivals": {
            "kind": "piecewise",
            "bucket_s": 2400,
            "per_hour": [
              90
            ],
            "spikes": [
              {
                "start_s": 900,
                "duration_s": 300,
                "multiplier": 10,
                "ramp_s": 30
              }
            ]
          },
          "handle_time": {
            "kind": "lognormal",
            "mean_s": 180,
            "cv": 0.8
          },
          "patience": {
            "kind": "exponential",
            "mean_s": 90
          },
          "max_entries": 40
        },
        {
          "id": "support",
          "max_wait_s": 240,
          "max_wait_action": {
            "action": "disconnect"
          },
          "arrivals": {
            "kind": "piecewise",
            "bucket_s": 2400,
            "per_hour": [
              40
            ]
          },
          "handle_time": {
            "kind": "lognormal",
            "mean_s": 180,
            "cv": 0.8
          },
          "patience": {
            "kind": "exponential",
            "mean_s": 90
          }
        }
      ],
      "agents": [
        {
          "count": 6,
          "ids": [
            "agent-a1",
            "agent-a2",
            "agent-a3"
          ],
          "id_prefix": "acme-s",
          "queues": [
            "sales",
            "support"
          ],
          "site": "site-a"
        }
      ],
      "behaviour": {
        "answer_delay": {
          "kind": "exponential",
          "mean_s": 3
        },
        "p_reject": 0.05,
        "p_ignore": 0.03,
        "p_leg_failed": 0.02,
        "p_no_answer": 0.02,
        "wrap_up": {
          "kind": "exponential",
          "mean_s": 20
        }
      }
    }
  ],
  "expectations": {
    "invariants": "all",
    "latency_ms": {
      "p99": 50,
      "max": 250
    },
    "rss_mib_max": 512
  }
}
